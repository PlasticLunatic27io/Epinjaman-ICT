<?php 
require_once __DIR__ . "/../dbcon.php"; 
$conn = dbcon(); 
session_start();

if (!isset($_SESSION['id']) || (trim($_SESSION['id']) == '')) {
    header("location:index.php");
    exit();
}
$session_id = $_SESSION['id'];

$query_user = mysqli_query($conn, "SELECT * FROM user WHERE user_id = '$session_id'") or die(mysqli_error($conn));
$user_row = mysqli_fetch_array($query_user);

$current_page = 'pemohon';

// Process CSV Upload
if(isset($_POST['import_csv'])) {
    $file = $_FILES['csvFile']['tmp_name'];
    if($file && file_exists($file)) {
        $success_count = 0; $error_count = 0; $errors = [];
        if (($handle = fopen($file, "r")) !== FALSE) {
            $row_number = 0;
            $first_row = fgetcsv($handle); 
            
            // Check if first row is header (contains "Name" or "ID")
            $has_header = (stripos($first_row[0], 'name') !== false || stripos($first_row[1], 'id') !== false);
            
            // If no header detected, rewind and process first row as data
            if (!$has_header) {
                rewind($handle);
            }
            
            while(($row = fgetcsv($handle, 1000, ",")) !== FALSE) {
                $row_number++;
                if(empty($row[0])) continue; 
                
                // Remove UTF-8 BOM if present in first column
                $row[0] = str_replace("\xEF\xBB\xBF", '', $row[0]);
                
                $name = mysqli_real_escape_string($conn, strtoupper(trim($row[0])));
                $collegeid = mysqli_real_escape_string($conn, trim($row[1]));
                $position = mysqli_real_escape_string($conn, trim($row[2]));
                $no_tel = mysqli_real_escape_string($conn, trim($row[3]));
                $email = mysqli_real_escape_string($conn, trim($row[4]));
                $dept = mysqli_real_escape_string($conn, trim($row[6])); // Column 7 (index 6)
                $status = mysqli_real_escape_string($conn, trim($row[7])) ?: 'Aktif'; // Column 8 (index 7)

                $check = mysqli_query($conn, "SELECT * FROM pemohon WHERE pemohon_college_id = '$collegeid'");
                if(mysqli_num_rows($check) > 0) { 
                    $error_count++; 
                    continue; 
                }

                $insert = mysqli_query($conn, "INSERT INTO pemohon (pemohon_name, pemohon_college_id, pemohon_position, pemohon_no_tel, pemohon_email, pemohon_dept, pemohon_status) 
                VALUES ('$name', '$collegeid', '$position', '$no_tel', '$email', '$dept', '$status')");
                
                if($insert) {
                    $success_count++;
                } else {
                    $error_count++;
                    $errors[] = "Row $row_number: " . mysqli_error($conn);
                }
            }
            fclose($handle);
            
            if($error_count > 0) {
                $result_message = "Import completed: $success_count added, $error_count skipped/failed.";
            } else {
                $result_message = "Import successful: $success_count personnel added!";
            }
        }
    }
}
