function sidebarQueueSql(string $queueKey): string {
    $queries = [
        'requests' => "SELECT borrow_id AS entity_id FROM borrowing WHERE status='Baru'",
        'release' => "SELECT approval_id AS entity_id FROM borrowing_approvals WHERE state='approved' AND handed_over_at IS NULL",
        'returns' => "SELECT borrow_item_id AS entity_id FROM borrowing_item WHERE status='Borrowed'",
    ];
    if (!isset($queries[$queueKey])) throw new InvalidArgumentException('Unknown notification queue.');
    return $queries[$queueKey];
}

function sidebarMarkQueueSeen(mysqli $conn, int $adminId, string $queueKey): void {
    if ($adminId < 1) return;
    $activeSql = sidebarQueueSql($queueKey);
    $stmt = $conn->prepare("INSERT IGNORE INTO admin_queue_seen (admin_id, queue_key, entity_id, seen_at) SELECT ?, ?, active.entity_id, NOW() FROM ($activeSql) active");
    $stmt->bind_param('is', $adminId, $queueKey);
    $stmt->execute();
}

function sidebarUnseenCount(mysqli $conn, int $adminId, string $queueKey): int {
    if ($adminId < 1) return 0;
    try {
        $activeSql = sidebarQueueSql($queueKey);
        $stmt = $conn->prepare("SELECT COUNT(*) FROM ($activeSql) active LEFT JOIN admin_queue_seen seen ON seen.admin_id=? AND seen.queue_key=? AND seen.entity_id=active.entity_id WHERE seen.entity_id IS NULL");
        $stmt->bind_param('is', $adminId, $queueKey);
        $stmt->execute();
        return (int)($stmt->get_result()->fetch_row()[0] ?? 0);
    } catch (Throwable $e) {
        error_log('Sidebar unseen count: ' . $e->getMessage());
        return 0;
    }
}

$sidebarAdminId = (int)($_SESSION['id'] ?? 0);
$queueForPage = ['borrow' => 'requests', 'borrow_approved' => 'release', 'return' => 'returns'];
if (isset($queueForPage[$current_page])) {
    try {
        sidebarMarkQueueSeen($conn, $sidebarAdminId, $queueForPage[$current_page]);
    } catch (Throwable $e) {
        error_log('Sidebar mark seen: ' . $e->getMessage());
    }
}

$newRequestCount = sidebarUnseenCount($conn, $sidebarAdminId, 'requests');
$readyReleaseCount = sidebarUnseenCount($conn, $sidebarAdminId, 'release');
$awaitingReturnCount = sidebarUnseenCount($conn, $sidebarAdminId, 'returns');

function sidebarBadge(int $count, string $tone = 'blue'): string {
    if ($count < 1) return '';
    $classes = $tone === 'amber' ? 'bg-amber-100 text-amber-700' : ($tone === 'green' ? 'bg-emerald-100 text-emerald-700' : 'bg-blue-100 text-blue-800');
    return '<span class="ml-auto min-w-[22px] h-[22px] px-1.5 inline-flex items-center justify-center rounded-full text-[10px] font-black ' . $classes . '" aria-label="' . $count . ' pending">' . ($count > 99 ? '99+' : $count) . '</span>';
}

