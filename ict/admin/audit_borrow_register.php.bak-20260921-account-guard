session_start();
if (($_SESSION['role'] ?? '') !== 'admin' || empty($_SESSION['id'])) {
    header('Location: ../login_form.php');
    exit;
}
require_once __DIR__ . '/../dbcon.php';
$conn = dbcon();
$adminId = (int) $_SESSION['id'];
$userStmt = $conn->prepare('SELECT name FROM user WHERE user_id = ?');
$userStmt->bind_param('i', $adminId);
$userStmt->execute();
