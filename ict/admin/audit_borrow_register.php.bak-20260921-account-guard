function auditE($value) { return htmlspecialchars((string)$value, ENT_QUOTES, 'UTF-8'); }
function auditUpper($value) { return mb_strtoupper(trim((string)$value), 'UTF-8'); }
function auditDateTime($value) {
    if (!$value || str_starts_with((string)$value, '0000-00-00') || str_starts_with((string)$value, '1970-01-01')) return '';
    $time = strtotime((string)$value);
    return $time ? date('d-m-Y H:i', $time) : '';
}
function validDate($value) {
    $date = DateTimeImmutable::createFromFormat('!Y-m-d', (string)$value);
    return $date && $date->format('Y-m-d') === $value;
}

$currentYear = date('Y');
$from = (string)($_GET['from'] ?? ($currentYear . '-01-01'));
$to = (string)($_GET['to'] ?? date('Y-m-d'));
$error = '';
if (!validDate($from) || !validDate($to)) $error = 'Choose valid From and To dates.';
elseif ($from > $to) $error = 'The From date cannot be later than the To date.';

$rows = [];
if (!$error) {
    $sql = "SELECT bi.borrow_item_id,bi.borrow_id,bi.item_tag,bi.item_qty,bi.status AS item_status,
                   bi.return_date,bi.notes AS return_notes,bi.returned_by_name,
                   COALESCE(NULLIF(i.item_name,''),b.borrow_item) AS item_name,
                   COALESCE(NULLIF(b.applicant_name,''),p.pemohon_name) AS pemohon_name,p.pemohon_college_id,COALESCE(NULLIF(b.applicant_department,''),p.pemohon_dept) AS pemohon_dept,COALESCE(NULLIF(b.applicant_phone,''),p.pemohon_no_tel) AS pemohon_no_tel,
                   b.location,b.start_date,b.end_date,b.notes AS borrow_notes,b.user_name,
                   wa.confirmed_name,wa.handed_over_at
            FROM borrowing_item bi
            JOIN borrowing b ON b.borrow_id=bi.borrow_id
            LEFT JOIN item i ON i.item_tag=bi.item_tag
            LEFT JOIN pemohon p ON p.pemohon_college_id=bi.pemohon_college_id
            LEFT JOIN borrowing_approvals wa ON wa.approval_id=(
                SELECT MAX(w2.approval_id) FROM borrowing_approvals w2
                WHERE w2.borrow_id=b.borrow_id AND w2.handed_over_at IS NOT NULL
            )
            WHERE bi.status IN ('Borrowed','Returned')
              AND DATE(b.start_date) BETWEEN ? AND ?
            ORDER BY b.start_date,bi.borrow_id,bi.borrow_item_id";
    $stmt = $conn->prepare($sql);
    $stmt->bind_param('ss', $from, $to);
    $stmt->execute();
    $rows = $stmt->get_result()->fetch_all(MYSQLI_ASSOC);
}

if (($_GET['format'] ?? '') === 'xlsx' && !$error) {
    $exportRows = [];
    foreach ($rows as $row) {
        $returned = $row['item_status'] === 'Returned';
        $exportRows[] = [
            'itemName'=>auditUpper($row['item_name']), 'itemTag'=>auditUpper($row['item_tag']),
            'quantity'=>(int)$row['item_qty'], 'borrowerName'=>auditUpper($row['pemohon_name']),
            'idDepartment'=>auditUpper($row['pemohon_college_id'].' / '.$row['pemohon_dept']),
            'phone'=>(string)$row['pemohon_no_tel'], 'location'=>auditUpper($row['location']),
            'borrowedAt'=>(string)$row['start_date'],
            'borrowOfficer'=>auditUpper($row['confirmed_name'] ?: $row['user_name']),
            'returnedAt'=>$returned ? (string)$row['return_date'] : '',
            'returnOfficer'=>$returned ? auditUpper($row['returned_by_name']) : '',
            'remarks'=>auditUpper(($returned?'SELESAI':'BELUM DIPULANGKAN').($row['return_notes']?' / '.$row['return_notes']:''))
        ];
    }
    $logo = __DIR__.'/../logokptm.png';
    $payload = ['fromLabel'=>date('d-m-Y',strtotime($from)),'toLabel'=>date('d-m-Y',strtotime($to)),'rows'=>$exportRows,'logoDataUrl'=>is_file($logo)?'data:image/png;base64,'.base64_encode(file_get_contents($logo)):null];
    $json = tempnam(sys_get_temp_dir(),'ict_audit_');
    $outputBase = tempnam(sys_get_temp_dir(),'ict_xlsx_');
    $output = $outputBase.'.xlsx';
    try {
        if ($json===false || $outputBase===false || file_put_contents($json,json_encode($payload,JSON_UNESCAPED_UNICODE|JSON_UNESCAPED_SLASHES|JSON_THROW_ON_ERROR))===false) throw new RuntimeException('Unable to prepare the Excel data.');
        @unlink($outputBase);
        $node = getenv('ICT_NODE_EXECUTABLE') ?: 'C:/Users/User/.cache/codex-runtimes/codex-primary-runtime/dependencies/node/bin/node.exe';
        $generator = getenv('ICT_AUDIT_XLSX_GENERATOR') ?: 'C:/xampp/private/ict/xlsx-runtime/generate_audit_xlsx.mjs';
        $command = escapeshellarg($node).' '.escapeshellarg($generator).' '.escapeshellarg($json).' '.escapeshellarg($output).' 2>&1';
        $lines=[];$exit=1;exec($command,$lines,$exit);
        if ($exit!==0 || !is_file($output) || filesize($output)<1000 || file_get_contents($output,false,null,0,2)!=='PK') {
            error_log('Audit XLSX generation: '.implode("\n",$lines));
            throw new RuntimeException('Unable to generate the Excel workbook.');
        }
        $python = getenv('ICT_PYTHON_EXECUTABLE') ?: 'C:/Users/User/.cache/codex-runtimes/codex-primary-runtime/dependencies/python/python.exe';
        $printPatch = getenv('ICT_AUDIT_XLSX_PRINT_PATCH') ?: 'C:/xampp/private/ict/xlsx-runtime/patch_print_settings.py';
        $patchCommand = escapeshellarg($python).' '.escapeshellarg($printPatch).' '.escapeshellarg($output).' '.(max(count($exportRows),20)+7).' 2>&1';
        $patchLines=[];$patchExit=1;exec($patchCommand,$patchLines,$patchExit);
        if ($patchExit!==0 || !is_file($output)) {
            error_log('Audit XLSX print settings: '.implode("\n",$patchLines));
            throw new RuntimeException('Unable to prepare the workbook for printing.');
        }
        $filename='DAFTAR_PERGERAKAN_PINJAMAN_'.$from.'_HINGGA_'.$to.'.xlsx';
        header('Content-Type: application/vnd.openxmlformats-officedocument.spreadsheetml.sheet');
        header('Content-Disposition: attachment; filename="'.$filename.'"');
        header('Content-Length: '.filesize($output)); header('Cache-Control: no-store');
        readfile($output); exit;
    } catch (Throwable $failure) {
        error_log('Audit Excel export: '.$failure->getMessage());
        $error='Unable to create the Excel workbook. Please try again later.';
    } finally { if($json)@unlink($json); if($outputBase)@unlink($outputBase); @unlink($output); }
}

if (($_GET['format'] ?? '') === 'csv' && !$error) {
    $filename = 'DAFTAR_PERGERAKAN_PINJAMAN_' . $from . '_HINGGA_' . $to . '.csv';
    header('Content-Type: text/csv; charset=UTF-8');
    header('Content-Disposition: attachment; filename="' . $filename . '"');
    header('Cache-Control: no-store');
    echo "\xEF\xBB\xBF";
    $out = fopen('php://output', 'w');
    fputcsv($out, ['BIL','NAMA PERALATAN','NO TAG JTM','KUANTITI','NAMA PEMINJAM','NO ID / JABATAN','NO TELEFON','LOKASI PENGGUNAAN','TARIKH & MASA PINJAMAN','T/T PEMINJAM','NAMA JTK','T/T JTK','TARIKH & MASA PEMULANGAN','T/T PEMINJAM','NAMA JTK','T/T JTK','CATATAN']);
    foreach ($rows as $index => $row) {
        $returnName = $row['returned_by_name'] ?: '';
        $status = $row['item_status'] === 'Returned' ? 'SELESAI' : 'BELUM DIPULANGKAN';
        fputcsv($out, [$index+1,auditUpper($row['item_name']),auditUpper($row['item_tag']),(int)$row['item_qty'],auditUpper($row['pemohon_name']),auditUpper($row['pemohon_college_id'].' / '.$row['pemohon_dept']),auditUpper($row['pemohon_no_tel']),auditUpper($row['location']),auditUpper(auditDateTime($row['start_date'])),'',auditUpper($row['confirmed_name'] ?: $row['user_name']),'',auditUpper(auditDateTime($row['return_date'])),'',auditUpper($returnName),'',auditUpper($status . ($row['return_notes'] ? ' / '.$row['return_notes'] : ''))]);
    }
    fclose($out);
    exit;
}
