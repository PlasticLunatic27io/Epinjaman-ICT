    require_once __DIR__ . '/../dbcon.php';
    $conn = dbcon();
}

function sidebarCount(mysqli $conn, string $sql): int {
    try {
        $result = $conn->query($sql);
        $row = $result ? $result->fetch_row() : null;
        return (int)($row[0] ?? 0);
    } catch (Throwable $e) {
        error_log('Sidebar count: ' . $e->getMessage());
        return 0;
    }
}

$newRequestCount = sidebarCount($conn, "SELECT COUNT(*) FROM borrowing WHERE status='Baru'");
$readyReleaseCount = sidebarCount($conn, "SELECT COUNT(*) FROM borrowing_approvals WHERE state='approved' AND handed_over_at IS NULL");
$awaitingReturnCount = sidebarCount($conn, "SELECT COUNT(*) FROM borrowing_item WHERE status='Borrowed'");

function sidebarBadge(int $count, string $tone = 'blue'): string {
    if ($count < 1) return '';
    $classes = $tone === 'amber' ? 'bg-amber-100 text-amber-700' : ($tone === 'green' ? 'bg-emerald-100 text-emerald-700' : 'bg-blue-100 text-blue-800');
    return '<span class="ml-auto min-w-[22px] h-[22px] px-1.5 inline-flex items-center justify-center rounded-full text-[10px] font-black ' . $classes . '" aria-label="' . $count . ' pending">' . ($count > 99 ? '99+' : $count) . '</span>';
}

